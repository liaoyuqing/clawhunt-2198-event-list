.wf {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.wf__col {
  width: 48.6%;
  display: flex;
  flex-direction: column;
}

.wf__card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.wf__cover {
  height: 200rpx;
  background: linear-gradient(135deg, #dbe6ff, #eef4ff);
  color: #0052d9;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wf__body {
  padding: 16rpx 18rpx 20rpx;
}

.wf__title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1f2329;
  margin-bottom: 10rpx;
}

.wf__meta {
  font-size: 22rpx;
  color: #8a9099;
  line-height: 1.6;
}

.wf__tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #0052d9;
  background: #eef4ff;
  border-radius: 8rpx;
}
