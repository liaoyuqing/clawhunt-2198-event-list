<view class="wf">
  <view class="wf__col">
    <view wx:for="{{left}}" wx:key="id" class="wf__card" data-id="{{item.id}}" bindtap="onTap">
      <view class="wf__cover">{{item.typeLabel}}</view>
      <view class="wf__body">
        <view class="wf__title">{{item.title}}</view>
        <view class="wf__meta">{{item.startTime}}</view>
        <view class="wf__meta">{{item.location}}</view>
        <view class="wf__tag">{{item.status}}</view>
      </view>
    </view>
  </view>
  <view class="wf__col">
    <view wx:for="{{right}}" wx:key="id" class="wf__card" data-id="{{item.id}}" bindtap="onTap">
      <view class="wf__cover">{{item.typeLabel}}</view>
      <view class="wf__body">
        <view class="wf__title">{{item.title}}</view>
        <view class="wf__meta">{{item.startTime}}</view>
        <view class="wf__meta">{{item.location}}</view>
        <view class="wf__tag">{{item.status}}</view>
      </view>
    </view>
  </view>
</view>
