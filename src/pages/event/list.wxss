.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.tabs-wrap {
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-bar {
  background: #ffffff;
  white-space: nowrap;
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid #eef0f2;
}

.filter-inner {
  display: inline-flex;
  flex-direction: row;
  padding: 0 24rpx;
}

.chip {
  flex: none;
  margin-right: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4b5563;
  background: #f2f3f5;
  line-height: 1.4;
}

.chip--active {
  color: #ffffff;
  background: #0052d9;
}

.panels {
  padding: 20rpx 16rpx 0;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  color: #8a9099;
  font-size: 28rpx;
}

.state__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef0f2;
  color: #b4b9c0;
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.state__text {
  margin-bottom: 28rpx;
}

.footer {
  text-align: center;
  color: #9aa0a6;
  font-size: 24rpx;
  padding: 28rpx 0 12rpx;
}
